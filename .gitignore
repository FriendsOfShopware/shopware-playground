!versions-src/*/shopware/overrides/
!versions-src/*/shopware/config/
!versions-src/*/shopware/composer.json
!versions-src/*/shopware/composer.lock

# persistent MariaDB datadirs (lite4mariadb NODEFS, per version)
data/mariadb*/

# Shopware runtime state
shopware/var/cache/
shopware/var/log/

# Cloudflare local dev state
.wrangler/
