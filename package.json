{
  "name": "shopware-playground",
  "version": "0.2.0",
  "description": "In-browser Shopware playground powered by PHP WASM and lite4mariadb (MariaDB WASM)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=180000 --test-concurrency=1 test/*.test.mjs",
    "dev": "node src/build-shell.mjs --workers && vite",
    "start": "node src/serve.mjs",
    "build": "node src/copy-assets.mjs",
    "build:shell": "node src/build-shell.mjs",
    "deploy:cf": "node src/deploy-cf.mjs",
    "prepare-install": "node src/prepare-install.mjs",
    "pack-deploy": "node src/pack-deploy.mjs"
  },
  "dependencies": {
    "@php-wasm/node": "^3.1.52",
    "@php-wasm/universal": "^3.1.52",
    "@php-wasm/web": "^3.1.52",
    "esbuild": "^0.28.2",
    "lite4mariadb": "^0.1.2"
  },
  "overrides": {
    "fs-ext-extra-prebuilt": "file:./shims/fs-ext-stub"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "aws4fetch": "^1.0.20",
    "playwright": "^1.62.1",
    "svelte": "^5.57.0",
    "vite": "^8.2.2"
  }
}
